---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import { useTranslations } from '../i18n/ui';
import type { Lang, RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  projectSlug?: string;
  title?: string;
  description?: string;
  showIntro?: boolean;
}

const { lang, routeKey, projectSlug, title, description, showIntro = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${t('brand.name')}` : t('meta.title');
const pageDescription = description ?? t('meta.description');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream text-ink font-body antialiased">
    {showIntro && <IntroAnimation lang={lang} />}
    <Header lang={lang} routeKey={routeKey} projectSlug={projectSlug} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
