---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const word1 = 'ABELLAN'.split('');
const word2 = 'PAYSAGE'.split('');
---

<div id="intro-overlay" role="presentation" aria-hidden="true">
  <button id="intro-skip" class="absolute bottom-8 right-8 text-[0.65rem] uppercase tracking-[0.25em] text-cream/50 hover:text-cream transition-colors">
    {t('intro.enter')}
  </button>
  <div class="flex flex-col items-center">
    <div class="font-display italic text-cream text-5xl sm:text-7xl flex" aria-hidden="true">
      {word1.map((letter, i) => (
        <span class="intro-letter" style={`animation-delay:${0.35 + i * 0.05}s`}>{letter}</span>
      ))}
    </div>
    <div class="mt-3 flex text-cream/80 text-[0.7rem] sm:text-xs tracking-[0.5em] uppercase">
      {word2.map((letter, i) => (
        <span class="intro-letter" style={`animation-delay:${0.9 + i * 0.04}s`}>{letter}</span>
      ))}
    </div>
    <div class="intro-rule mt-6 h-px w-24 bg-cream/40"></div>
  </div>
</div>

<script>
  const overlay = document.getElementById('intro-overlay');
  const skipBtn = document.getElementById('intro-skip');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function hideIntro() {
    if (!overlay) return;
    overlay.classList.add('intro-hide');
    document.body.classList.remove('no-scroll');
    window.setTimeout(() => {
      overlay.style.display = 'none';
    }, 1150);
  }

  if (!overlay) {
    // no-op
  } else if (sessionStorage.getItem('abellan-intro-shown') || prefersReducedMotion) {
    overlay.style.display = 'none';
  } else {
    document.body.classList.add('no-scroll');
    sessionStorage.setItem('abellan-intro-shown', '1');
    window.requestAnimationFrame(() => overlay.classList.add('intro-rule-in'));
    const autoHide = window.setTimeout(hideIntro, 2400);
    skipBtn?.addEventListener('click', () => {
      window.clearTimeout(autoHide);
      hideIntro();
    });
  }
</script>
