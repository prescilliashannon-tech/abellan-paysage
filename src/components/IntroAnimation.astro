---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const word1 = 'ABELLAN'.split('');
const word2 = 'PAYSAGE'.split('');
---

<div id="intro-overlay" role="presentation" aria-hidden="true">
  <button
    id="intro-skip"
    class="absolute bottom-8 right-8 text-[0.65rem] uppercase tracking-[0.25em] text-ink/40 hover:text-ink transition-colors"
  >
    {t('intro.enter')}
  </button>
  <div class="intro-content relative w-64 sm:w-80 aspect-[6031/5624] px-6 [container-type:inline-size]">
    <img
      src="/images/brand/logo-full.png"
      alt=""
      class="intro-logo absolute inset-0 h-full w-full"
    />
    <div
      class="absolute flex items-center justify-center"
      style="left:3.3%; right:3.3%; top:42.7%; height:14.1%;"
    >
      <div class="flex" aria-hidden="true">
        {word1.map((letter, i) => (
          <span
            class="intro-letter font-body font-black text-[#3B3F2F] text-[25cqw] tracking-tight"
            style={`animation-delay:${0.5 + i * 0.045}s`}
          >
            {letter}
          </span>
        ))}
      </div>
    </div>
    <div
      class="absolute flex items-center justify-end"
      style="left:63.3%; right:3.3%; top:58.2%; height:8.5%;"
    >
      <div class="flex" aria-hidden="true">
        {word2.map((letter, i) => (
          <span
            class="intro-letter font-body font-bold text-[#575F3C] text-[0.5rem] sm:text-[0.6rem] tracking-[0.35em]"
            style={`animation-delay:${0.95 + i * 0.035}s`}
          >
            {letter}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('intro-overlay');
  const skipBtn = document.getElementById('intro-skip');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function hideIntro() {
    if (!overlay) return;
    overlay.classList.add('intro-hide');
    document.body.classList.remove('no-scroll');
    window.setTimeout(() => {
      overlay.style.display = 'none';
    }, 1000);
  }

  if (!overlay) {
    // no-op
  } else if (sessionStorage.getItem('abellan-intro-shown') || prefersReducedMotion) {
    overlay.style.display = 'none';
  } else {
    document.body.classList.add('no-scroll');
    sessionStorage.setItem('abellan-intro-shown', '1');

    window.requestAnimationFrame(() => overlay.classList.add('intro-badge-in'));

    const autoHide = window.setTimeout(hideIntro, 2300);
    skipBtn?.addEventListener('click', () => {
      window.clearTimeout(autoHide);
      hideIntro();
    });
  }
</script>
