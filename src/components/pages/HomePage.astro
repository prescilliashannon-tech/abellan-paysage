---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations, type UIKey } from '../../i18n/ui';
import { localizedPath, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);
const featuredProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const processImages = [
  '/images/placeholders/bougainvillier-mur.jpg',
  '/images/placeholders/terrasse-pierre.jpg',
  '/images/placeholders/allee-jardin.jpg',
  '/images/placeholders/mur-pierre-vegetal.jpg',
  '/images/placeholders/cour-oleandre.jpg',
  '/images/placeholders/jardin-mediterraneen.jpg'
];

const steps = [1, 2, 3, 4, 5, 6].map((n) => ({
  title: t(`home.process.step${n}.title` as UIKey),
  text: t(`home.process.step${n}.text` as UIKey),
  image: processImages[n - 1]
}));
---

<Layout lang={lang} routeKey="home" showIntro={true}>
  <!-- Hero -->
  <section class="pb-8 sm:pb-10">
    <div class="w-full aspect-[21/9] overflow-hidden" data-reveal>
      <img
        src="/images/projects/mas-catalan/image00011.jpeg"
        alt=""
        class="h-full w-full object-cover"
        fetchpriority="high"
      />
    </div>
    <div class="mt-10 sm:mt-14 mx-auto max-w-7xl px-6 lg:px-10" data-reveal>
      <div class="max-w-2xl">
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight">{t('home.hero.title')}</h1>
        <p class="mt-6 text-ink-soft leading-relaxed max-w-xl">{t('home.hero.subtitle')}</p>
        <a
          href={localizedPath(lang, 'contact')}
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-ink px-6 py-3 text-sm hover:bg-ink hover:text-cream transition-colors"
        >
          {t('nav.contact')}
          <span class="text-lg leading-none">+</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Intro / About teaser -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[#EEF1E3]"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-10 pb-24 lg:pt-14 lg:pb-32 grid lg:grid-cols-[1.15fr_0.85fr] gap-14 lg:gap-20 items-center">
      <div data-reveal>
        <p class="text-xs uppercase tracking-[0.3em] text-olive mb-4">{t('home.intro.eyebrow')}</p>
        <h2 class="font-display text-3xl sm:text-4xl leading-tight max-w-lg">{t('home.intro.title')}</h2>
        <p class="mt-6 text-ink-soft leading-relaxed max-w-lg">{t('home.intro.text1')}</p>
        <p class="mt-4 text-ink-soft leading-relaxed max-w-lg">{t('home.intro.text2')}</p>
        <a
          href={localizedPath(lang, 'about')}
          class="mt-8 inline-flex items-center gap-2 text-xs uppercase tracking-widest text-ink border-b border-ink pb-1 hover:text-olive hover:border-olive transition-colors"
        >
          {t('home.intro.cta')} →
        </a>
      </div>
      <div class="relative max-w-sm mx-auto lg:mx-0 lg:ml-auto mt-10 lg:mt-0" data-reveal>
        <div class="aspect-[3/4] overflow-hidden">
          <img
            src="/images/projects/jardin-lupia/image00014.jpeg"
            alt=""
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="absolute -top-8 -left-6 sm:-top-10 sm:-left-10 w-28 sm:w-36 aspect-[4/3] overflow-hidden border-[3px] border-cream shadow-xl">
          <img
            src="/images/sketch/croquis-plan-main.jpg"
            alt=""
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Notre démarche -->
  <section class="bg-cream-dark py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 lg:flex lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:w-[30%] lg:shrink-0" data-reveal>
        <p class="text-xs uppercase tracking-[0.3em] text-olive mb-4">{t('home.process.eyebrow')}</p>
        <h2 class="font-display text-3xl sm:text-4xl">{t('home.process.title')}</h2>
        <p class="mt-6 text-ink-soft leading-relaxed max-w-sm">{t('home.process.text')}</p>
      </div>

      <div class="mt-16 lg:mt-0 lg:flex-1 border-t border-stone/60">
        {steps.map((step, i) => (
          <div
            class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10 py-10 px-4 sm:px-6 -mx-4 sm:-mx-6 border-b border-stone/60 transition-colors duration-500 hover:bg-stone"
            data-reveal
          >
            <div class="flex-1">
              <span class="text-xs text-olive tracking-widest">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-2xl sm:text-3xl mt-3">{step.title}</h3>
              <p class="mt-4 text-ink-soft leading-relaxed max-w-md">{step.text}</p>
            </div>
            <div class="w-full sm:w-56 md:w-64 shrink-0 aspect-[4/3] overflow-hidden">
              <img src={step.image} alt="" loading="lazy" class="h-full w-full object-cover" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nos réalisations -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 mb-14" data-reveal>
      <p class="text-xs uppercase tracking-[0.3em] text-olive mb-4">{t('home.projects.eyebrow')}</p>
      <h2 class="font-display text-3xl sm:text-4xl max-w-xl">{t('home.projects.title')}</h2>
      <p class="mt-4 text-ink-soft max-w-lg">{t('home.projects.text')}</p>
    </div>

    <div class="relative border-t border-stone/60">
      {featuredProjects.map((project, i) => (
        <a
          href={`${localizedPath(lang, 'projects')}${project.data.pageSlug}/`}
          class="group sticky top-20 flex h-[85vh] min-h-[480px] flex-col bg-cream overflow-hidden"
          style={`z-index:${i + 1}`}
          data-reveal
        >
          <div class="mx-auto max-w-7xl w-full px-6 lg:px-10 py-6 flex items-center justify-between gap-6 shrink-0 bg-cream">
            <h3 class="font-display text-2xl sm:text-3xl group-hover:text-olive transition-colors">
              {project.data.title}
            </h3>
            <span class="text-2xl text-olive shrink-0 transition-transform duration-500 group-hover:rotate-45">+</span>
          </div>
          <div class="flex-1 overflow-hidden">
            <img
              src={project.data.cover}
              alt={project.data.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        </a>
      ))}
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10 mt-10 text-right" data-reveal>
      <a
        href={localizedPath(lang, 'projects')}
        class="text-xs uppercase tracking-widest text-ink border-b border-ink pb-1 hover:text-olive hover:border-olive transition-colors"
      >
        {t('home.projects.cta')} →
      </a>
    </div>
  </section>

  <!-- CTA band -->
  <section class="relative min-h-[380px] sm:min-h-[440px] flex items-center justify-center overflow-hidden">
    <img
      src="/images/projects/jardin-gravier/image00022.jpeg"
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-ink/50"></div>
    <div
      class="relative z-10 mx-6 max-w-lg border border-cream/80 px-6 py-9 sm:px-10 sm:py-10 text-center"
      data-reveal
    >
      <h2 class="font-display text-cream text-2xl sm:text-3xl leading-tight">{t('home.cta.title')}</h2>
      <p class="mt-4 text-cream/85 text-sm max-w-sm mx-auto">{t('home.cta.text')}</p>
      <a
        href={localizedPath(lang, 'contact')}
        class="mt-7 inline-flex items-center gap-2 border border-cream text-cream px-6 py-3 text-xs uppercase tracking-widest hover:bg-cream hover:text-ink transition-colors"
      >
        {t('home.cta.button')} →
      </a>
    </div>
  </section>
</Layout>
