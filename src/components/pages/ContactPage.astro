---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';
import { FORMSPREE_ID } from '../../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const formEndpoint = `https://formspree.io/f/${FORMSPREE_ID}`;
---

<Layout lang={lang} routeKey="contact" title={t('nav.contact')}>
  <section class="mx-auto max-w-7xl px-6 lg:px-10 pt-36 pb-24 lg:pb-32 grid lg:grid-cols-2 gap-16">
    <div data-reveal>
      <p class="text-xs uppercase tracking-[0.3em] text-olive mb-4">{t('contact.eyebrow')}</p>
      <h1 class="font-display text-4xl sm:text-5xl max-w-md">{t('contact.title')}</h1>
      <p class="mt-5 text-ink-soft max-w-md">{t('contact.text')}</p>

      <div class="mt-12 border-t border-stone/60 pt-8">
        <h2 class="text-xs uppercase tracking-widest text-ink-soft mb-5">{t('contact.direct.title')}</h2>
        <ul class="space-y-3 text-ink">
          <li class="flex justify-between max-w-xs">
            <span class="text-ink-soft text-sm">{t('contact.direct.email')}</span>
            <a href="mailto:abellan.paysage@gmail.com" class="hover:text-olive transition-colors">abellan.paysage@gmail.com</a>
          </li>
          <li class="flex justify-between max-w-xs">
            <span class="text-ink-soft text-sm">{t('contact.direct.zone')}</span>
            <span>Occitanie &amp; P.-O.</span>
          </li>
          <li class="flex justify-between max-w-xs">
            <span class="text-ink-soft text-sm">{t('contact.direct.social')}</span>
            <span>Abellan Paysage</span>
          </li>
        </ul>
      </div>
    </div>

    <form id="contact-form" class="space-y-5" data-reveal action={formEndpoint} method="POST">
      <input type="hidden" name="_subject" value={t('contact.form.subject')} />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs uppercase tracking-widest text-ink-soft mb-2" for="name">{t('contact.form.name')}</label>
          <input id="name" name="name" type="text" required class="w-full border border-stone bg-cream px-4 py-3 text-sm focus:outline-none focus:border-olive" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-widest text-ink-soft mb-2" for="email">{t('contact.form.email')}</label>
          <input id="email" name="email" type="email" required class="w-full border border-stone bg-cream px-4 py-3 text-sm focus:outline-none focus:border-olive" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs uppercase tracking-widest text-ink-soft mb-2" for="phone">{t('contact.form.phone')}</label>
          <input id="phone" name="phone" type="tel" class="w-full border border-stone bg-cream px-4 py-3 text-sm focus:outline-none focus:border-olive" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-widest text-ink-soft mb-2" for="location">{t('contact.form.location')}</label>
          <input id="location" name="location" type="text" class="w-full border border-stone bg-cream px-4 py-3 text-sm focus:outline-none focus:border-olive" />
        </div>
      </div>
      <div>
        <label class="block text-xs uppercase tracking-widest text-ink-soft mb-2" for="type">{t('contact.form.type')}</label>
        <select id="type" name="type" class="w-full border border-stone bg-cream px-4 py-3 text-sm focus:outline-none focus:border-olive">
          <option>{t('contact.form.type.quote')}</option>
          <option>{t('contact.form.type.info')}</option>
        </select>
      </div>
      <div>
        <label class="block text-xs uppercase tracking-widest text-ink-soft mb-2" for="message">{t('contact.form.message')}</label>
        <textarea id="message" name="message" rows="5" required class="w-full border border-stone bg-cream px-4 py-3 text-sm focus:outline-none focus:border-olive"></textarea>
      </div>

      <button
        id="contact-form-submit"
        type="submit"
        class="inline-flex items-center gap-2 bg-ink text-cream px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-olive-dark transition-colors disabled:opacity-50"
      >
        {t('contact.form.submit')}
      </button>

      <p id="contact-form-success" class="hidden text-sm text-olive pt-2" role="status">{t('contact.form.success')}</p>
      <p id="contact-form-error" class="hidden text-sm text-terracotta pt-2" role="alert">{t('contact.form.error')}</p>
    </form>
  </section>

  <script define:vars={{
    formEndpoint,
    submitLabel: t('contact.form.submit'),
    sendingLabel: t('contact.form.sending'),
    isPlaceholder: FORMSPREE_ID === 'VOTRE_ID_FORMSPREE'
  }}>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-form-submit');
    const successMsg = document.getElementById('contact-form-success');
    const errorMsg = document.getElementById('contact-form-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');

      if (isPlaceholder) {
        // Formspree pas encore configuré (voir src/config.ts) : on ne peut pas envoyer réellement.
        console.warn('Formspree n\'est pas configuré : voir src/config.ts (FORMSPREE_ID).');
        errorMsg?.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = sendingLabel;

      try {
        const response = await fetch(formEndpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        });

        if (response.ok) {
          form.reset();
          successMsg?.classList.remove('hidden');
        } else {
          errorMsg?.classList.remove('hidden');
        }
      } catch {
        errorMsg?.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  </script>
</Layout>
