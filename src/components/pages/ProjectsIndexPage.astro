---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../ProjectCard.astro';
import { useTranslations } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout lang={lang} routeKey="projects" title={t('nav.projects')}>
  <section class="relative h-[92vh] min-h-[560px] flex items-end">
    <img src="/images/projects/jardin-lupia/image00017.jpeg" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-ink/30"></div>
    <div class="relative z-10 mx-auto max-w-7xl w-full px-6 lg:px-10 pb-20">
      <p class="text-cream/80 text-xs uppercase tracking-[0.3em] mb-5">{t('projects.eyebrow')}</p>
      <h1 class="font-display text-cream text-4xl sm:text-6xl lg:text-7xl leading-[1.05] max-w-3xl">{t('projects.title')}</h1>
      <p class="mt-6 text-cream/90 text-base sm:text-lg max-w-xl">{t('projects.text')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <ProjectCard
          lang={lang}
          slug={project.data.pageSlug}
          title={project.data.title}
          location={project.data.location}
          cover={project.data.cover}
          excerpt={project.data.excerpt}
        />
      ))}
    </div>
  </section>
</Layout>
