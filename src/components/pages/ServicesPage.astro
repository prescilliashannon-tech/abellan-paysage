---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';
import { localizedPath, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { title: t('services.1.title'), text: t('services.1.text') },
  { title: t('services.2.title'), text: t('services.2.text') },
  { title: t('services.3.title'), text: t('services.3.text') },
  { title: t('services.4.title'), text: t('services.4.text') },
  { title: t('services.5.title'), text: t('services.5.text') },
  { title: t('services.6.title'), text: t('services.6.text') }
];
---

<Layout lang={lang} routeKey="services" title={t('nav.services')}>
  <section class="relative h-[46vh] min-h-[360px] flex items-end">
    <img src="/images/placeholders/terrasse-pierre.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-ink/45"></div>
    <div class="relative z-10 mx-auto max-w-7xl w-full px-6 lg:px-10 pb-14">
      <p class="text-cream/80 text-xs uppercase tracking-[0.3em] mb-4">{t('services.eyebrow')}</p>
      <h1 class="font-display text-cream text-4xl sm:text-5xl lg:text-6xl max-w-2xl">{t('services.title')}</h1>
      <p class="mt-5 text-cream/90 max-w-xl">{t('services.text')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-24 lg:py-32">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-stone/60">
      {services.map((service, i) => (
        <div class="bg-cream p-8 lg:p-10" data-reveal>
          <span class="text-xs text-olive tracking-widest">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="font-display text-xl mt-3 mb-3">{service.title}</h2>
          <p class="text-sm text-ink-soft leading-relaxed">{service.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-olive-dark text-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-10 py-20 text-center" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl">{t('services.pricing.title')}</h2>
      <p class="mt-5 text-cream/85 leading-relaxed">{t('services.pricing.text')}</p>
      <a
        href={localizedPath(lang, 'contact')}
        class="mt-9 inline-flex items-center gap-2 bg-cream text-ink px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-cream-dark transition-colors"
      >
        {t('services.pricing.cta')}
      </a>
    </div>
  </section>
</Layout>
