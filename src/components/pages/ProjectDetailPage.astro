---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../ProjectCard.astro';
import { useTranslations } from '../../i18n/ui';
import { localizedPath, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);

const otherProjects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .filter((p) => p.data.pageSlug !== project.data.pageSlug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout
  lang={lang}
  routeKey="projects"
  projectSlug={`${project.data.pageSlug}/`}
  title={project.data.title}
  description={project.data.excerpt}
>
  <section class="relative h-[70vh] min-h-[480px] flex items-end">
    <img src={project.data.cover} alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/10 to-transparent"></div>
    <div class="relative z-10 mx-auto max-w-7xl w-full px-6 lg:px-10 pb-16">
      <a
        href={localizedPath(lang, 'projects')}
        class="inline-flex items-center gap-2 text-cream/80 hover:text-cream text-xs uppercase tracking-widest mb-6"
      >
        &larr; {t('projects.back')}
      </a>
      <p class="text-cream/80 text-xs uppercase tracking-[0.3em] mb-4">{project.data.location}</p>
      <h1 class="font-display text-cream text-4xl sm:text-5xl lg:text-6xl max-w-3xl">{project.data.title}</h1>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 lg:px-10 py-20 lg:py-28">
    <div class="prose-content text-ink-soft leading-relaxed space-y-5" data-reveal>
      <Content />
    </div>
  </section>

  {project.data.images.length > 0 && (
    <section class="pb-24">
      <p class="mx-auto max-w-7xl px-6 lg:px-10 text-xs uppercase tracking-[0.3em] text-olive mb-6">
        {t('projects.gallery')}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 px-2 lg:px-8" id="project-gallery">
        {project.data.images.map((img, i) => (
          <button
            type="button"
            class="group aspect-[4/3] overflow-hidden"
            data-reveal
            data-lightbox-trigger
            data-index={i}
            aria-label={t('projects.viewProject')}
          >
            <img
              src={img}
              alt={project.data.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </button>
        ))}
      </div>
    </section>
  )}

  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-ink/95 px-4"
    role="dialog"
    aria-modal="true"
    aria-label={t('projects.gallery')}
  >
    <button
      type="button"
      id="lightbox-close"
      aria-label={t('intro.enter')}
      class="absolute top-6 right-6 text-cream/80 hover:text-cream transition-colors"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>
    <button
      type="button"
      id="lightbox-prev"
      aria-label="Précédent"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full border border-cream/40 text-cream/80 hover:text-cream hover:border-cream transition-colors"
    >
      <svg width="18" height="18" viewBox="0 0 22 16" fill="none" class="rotate-180">
        <path d="M1 8H21M21 8L14.5 1.5M21 8L14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button
      type="button"
      id="lightbox-next"
      aria-label="Suivant"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full border border-cream/40 text-cream/80 hover:text-cream hover:border-cream transition-colors"
    >
      <svg width="18" height="18" viewBox="0 0 22 16" fill="none">
        <path d="M1 8H21M21 8L14.5 1.5M21 8L14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[90vw] object-contain" />
    <p id="lightbox-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-cream/70 text-xs tracking-widest"></p>
  </div>

  <script>
    (function () {
      const gallery = document.getElementById('project-gallery');
      if (!gallery) return;

      const triggers = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
      const urls = triggers.map((t) => t.querySelector('img')?.getAttribute('src') || '');
      const lightbox = document.getElementById('lightbox') as HTMLElement;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const counter = document.getElementById('lightbox-counter') as HTMLElement;
      let index = 0;

      function show(i: number) {
        index = (i + urls.length) % urls.length;
        lightboxImg.src = urls[index];
        counter.textContent = `${index + 1} / ${urls.length}`;
      }

      function open(i: number) {
        show(i);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.classList.add('no-scroll');
      }

      function close() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.classList.remove('no-scroll');
      }

      triggers.forEach((trigger, i) => {
        trigger.addEventListener('click', () => open(i));
      });

      document.getElementById('lightbox-close')?.addEventListener('click', close);
      document.getElementById('lightbox-prev')?.addEventListener('click', () => show(index - 1));
      document.getElementById('lightbox-next')?.addEventListener('click', () => show(index + 1));

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(index - 1);
        if (e.key === 'ArrowRight') show(index + 1);
      });
    })();
  </script>

  {otherProjects.length > 0 && (
    <section class="bg-cream-dark py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <h2 class="font-display text-3xl mb-12" data-reveal>{t('projects.otherProjects')}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {otherProjects.map((p) => (
            <ProjectCard
              lang={lang}
              slug={p.data.pageSlug}
              title={p.data.title}
              location={p.data.location}
              cover={p.data.cover}
              excerpt={p.data.excerpt}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
