---
import { useTranslations } from '../i18n/ui';
import { localizedPath, type Lang } from '../i18n/routes';
import { SOCIAL_LINKS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { key: 'home', label: t('nav.home') },
  { key: 'about', label: t('nav.about') },
  { key: 'services', label: t('nav.services') },
  { key: 'gallery', label: t('nav.gallery') },
  { key: 'projects', label: t('nav.projects') },
  { key: 'contact', label: t('nav.contact') }
] as const;
---

<footer class="bg-ink text-cream">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16 grid grid-cols-2 gap-x-6 gap-y-12 sm:gap-12 lg:grid-cols-4">
    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <div class="inline-grid">
        <div class="justify-self-end leading-none">
          <span class="font-body font-bold uppercase text-2xl tracking-wide block text-right">Abellan</span>
          <span class="font-body italic text-sm block text-right">paysage</span>
        </div>
        <p class="mt-4 max-w-sm text-right text-cream/70 text-sm leading-relaxed">{t('footer.tagline')}</p>
      </div>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-widest text-cream/50 mb-4">{t('footer.nav.title')}</h3>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 sm:block sm:space-y-2">
        {links.map((link) => (
          <li>
            <a href={localizedPath(lang, link.key)} class="text-sm text-cream/85 hover:text-cream transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-widest text-cream/50 mb-4">{t('footer.contact.title')}</h3>
      <ul class="space-y-2 text-sm text-cream/85">
        <li>Occitanie &amp; Pyrénées-Orientales</li>
        <li><a href="mailto:abellan.paysage@gmail.com" class="hover:text-cream transition-colors">abellan.paysage@gmail.com</a></li>
        <li>Abellan Paysage</li>
      </ul>
      <div class="mt-6 flex items-center justify-end gap-4">
        <a
          href={SOCIAL_LINKS.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-cream/70 hover:text-cream transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
          </svg>
        </a>
        <a
          href={SOCIAL_LINKS.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-cream/70 hover:text-cream transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-cream/10">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-6 text-xs text-cream/50 flex flex-col sm:flex-row justify-between gap-2">
      <span>&copy; {year} {t('brand.name')}. {t('footer.rights')}</span>
    </div>
  </div>
</footer>
